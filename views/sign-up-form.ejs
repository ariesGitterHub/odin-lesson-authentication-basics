<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <main class="sign-up-main">
      <h1>please sign up</h1>
      <form class="sign-up-form" action="/sign-up" method="POST">
        <label for="username">
          <p>Username</p>
          <input
            id="username"
            name="username"
            placeholder="enter username"
            type="text"
          />
        </label>
        <label for="password">
          <p>Password</p>
          <input
            id="password"
            name="password"
            placeholder="enter password"
            type="password"
          />
        </label>
        <div class="button-container">
          <a class="fake-button" href="/">Back</a>
          <button type="submit">Sign Up</button>          
        </div>
      </form>
      <%- include('./partials/errors.ejs') %>  
    </main>
  </body>
</html>
