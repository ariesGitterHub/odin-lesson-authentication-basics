<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('./partials/head.ejs') %>
    </head>
    <body>
        <main class="log-in-main">
            <!-- So, this code checks to see if there is a user defined… if so it offers a welcome message, and if NOT then it shows the login form. Neat! -->
            <% if (locals.user) {%>
                <div class="welcome-back-container">
                    <h1>welcome back... "<%= user.username %>"</h1>
                    <div class="button-container">
                        <a class="fake-button" href="/log-out">LOG OUT</a>     
                    </div>                 
                </div>
            <% } else { %>
                <h1>please log in</h1>
                <form class="log-in-form" action="/log-in" method="POST">
                    <label for="username">
                        <p>Username</p>
                        <input id="username" name="username" placeholder="enter username" type="text" />               
                    </label>
                    <label for="password">
                        <p>Password</p>
                        <input id="password" name="password" placeholder="enter password" type="password" />             
                    </label>
                    <div class="button-container button-space-between">
                        <a class="fake-button" href="/">Clear</a>
                        <button type="submit">Log In</button>    
                    </div>
                    <a href="/sign-up">Create a username and password.</a>
                </form>
                <%- include('./partials/errors.ejs') %> 
            <%}%>       
        </main>
    </body>
</html>



